#!/bin/sh
set -eu

runtime_dir="${DSH_RUNTIME_DIR:-$HOME/.local/share/dsh}"
required_pnpm="11.24.0"

if command -v pnpm >/dev/null 2>&1; then
  pnpm_bin=$(command -v pnpm)
  case "$($pnpm_bin --version 2>/dev/null || true)" in
    11.*) pnpm_mode=standalone ;;
    *)
      if command -v npm >/dev/null 2>&1; then
        npm_bin=$(command -v npm)
        pnpm_mode=npm_exec
      else
        echo "dsh-update: pnpm $required_pnpm is required, but npm is unavailable" >&2
        exit 1
      fi
      ;;
  esac
elif command -v corepack >/dev/null 2>&1; then
  corepack_bin=$(command -v corepack)
  pnpm_mode=corepack
elif command -v npm >/dev/null 2>&1; then
  npm_bin=$(command -v npm)
  pnpm_mode=npm_exec
else
  node_bin="${DSH_NODE_BIN:-}"
  if [ -z "$node_bin" ] || [ ! -x "$node_bin" ]; then
    node_bin=$(command -v node 2>/dev/null || true)
  fi
  if [ -z "${node_bin:-}" ] || [ ! -x "$node_bin" ]; then
    node_bin=$(find "$HOME/.local/share/fnm/node-versions" -type f -path '*/installation/bin/node' -perm -111 2>/dev/null | sort -r | head -n 1 || true)
  fi
  if [ -z "${node_bin:-}" ] || [ ! -x "$node_bin" ]; then
    echo "dsh-update: no Node.js runtime found; set DSH_NODE_BIN or activate Node.js" >&2
    exit 1
  fi
  corepack_bin=$(dirname "$node_bin")/corepack
  if [ ! -x "$corepack_bin" ]; then
    echo "dsh-update: pnpm/corepack not found" >&2
    exit 1
  fi
  pnpm_mode=corepack
fi

# Allow build scripts: pnpm 11 exits non-zero (ERR_PNPM_IGNORED_BUILDS) when
# native deps (node-pty, koffi, protobufjs, ...) are not approved, which breaks
# `set -e` and skips their prebuilt binaries. This runtime only ever installs
# @deepseek-ai/dsh and its transitive deps, so allowing builds here is safe.
if [ "$pnpm_mode" = standalone ]; then
  pnpm_cmd() { "$pnpm_bin" --config.dangerouslyAllowAllBuilds=true "$@"; }
elif [ "$pnpm_mode" = npm_exec ]; then
  pnpm_cmd() { "$npm_bin" exec --yes --package="pnpm@$required_pnpm" -- pnpm --config.dangerouslyAllowAllBuilds=true "$@"; }
else
  pnpm_cmd() { "$corepack_bin" pnpm --config.dangerouslyAllowAllBuilds=true "$@"; }
fi

mkdir -p "$runtime_dir"

# The runtime is self-managed: chezmoi does not pin the dsh version.
# Bootstrap a minimal package.json on first use, then always resolve latest.
if [ ! -f "$runtime_dir/package.json" ]; then
  cat > "$runtime_dir/package.json" <<EOF
{
  "name": "local-dsh-runtime",
  "private": true,
  "packageManager": "pnpm@$required_pnpm",
  "dependencies": {
    "@deepseek-ai/dsh": "latest"
  }
}
EOF
  echo "dsh-update: bootstrapped $runtime_dir/package.json" >&2
fi

if [ -f "$runtime_dir/pnpm-lock.yaml" ]; then
  pnpm_cmd update --dir "$runtime_dir" --prod --latest '@deepseek-ai/dsh'
else
  pnpm_cmd install --dir "$runtime_dir" --prod
fi
pnpm_cmd rebuild --dir "$runtime_dir" --reporter=append-only
